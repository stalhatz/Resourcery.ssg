{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Site Design Configuration",
  "description": "BREAKING CHANGE: This schema replaces the old design vocabulary. Old design.json files with heading_size_scale, shadow_intensity, border_radius, or border_treatment will fail validation. Regenerate your design.json to match this schema.",
  "type": "object",
  "required": ["theme"],
  "additionalProperties": false,
  "properties": {
    "theme": {
      "type": "object",
      "required": ["colors", "typography", "layout", "effects"],
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "object",
          "required": ["primary", "background", "text"],
          "additionalProperties": false,
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "The dominant brand color used throughout the site."
            },
            "secondary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "default": "#64748b",
              "description": "Interaction color — used for hovers, focus states, and active transitions."
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "The base background color for the entire site."
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "default": "#f8fafc",
              "description": "The surface color used for cards, modals, dropdowns, and other elevated UI elements."
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "The primary text color for headings, body text, and prominent labels."
            },
            "text_muted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "default": "#64748b",
              "description": "The secondary text color for metadata, captions, timestamps, and less important text."
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "default": "#7c3aed",
              "description": "The highlight color used for key interactive elements — buttons, active states, notifications."
            },
            "error": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "default": "#dc2626",
              "description": "Color for error states."
            },
            "success": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "default": "#16a34a",
              "description": "Color for success states."
            },
            "levers": {
              "type": "object",
              "description": "Color system tuning knobs. Control saturation, warmth, and ramp depth without changing anchors.",
              "additionalProperties": false,
              "properties": {
                "brand_saturation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.8,
                  "description": "0 = fully desaturated/neutral brand, 1 = maximally saturated primary/accent."
                },
                "neutral_temperature": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1,
                  "default": 0,
                  "description": "-1 = cool grays (blue-tinted), 0 = true neutral, +1 = warm grays (beige-tinted)."
                },
                "shade_spread": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.6,
                  "description": "0 = narrow ramp (low contrast between light/dark shades), 1 = wide spread (high depth)."
                }
              }
            },
            "overlay_strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.7,
              "description": "Strength/opacity of derived image-overlay scrims. 0 = no scrim, 1 = maximum. Drives the alpha of --color-overlay."
            },
            "dark": {
              "type": "object",
              "description": "Optional dark mode color palette. All color fields are optional; auto derives dark ramp from levers when true.",
              "additionalProperties": false,
              "properties": {
                "auto": {
                  "type": "boolean",
                  "default": true,
                  "description": "When true (default), build derives dark ramp from levers. Explicit dark.* anchors override derived values."
                },
                "primary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "background": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "surface": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "text_muted": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "error": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "success": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "font_family": {
              "type": "string",
              "default": "Inter, system-ui, sans-serif",
              "description": "Primary font for body text. CSS font-family stack — include fallbacks."
            },
            "heading_font": {
              "type": "string",
              "default": "Inter, system-ui, sans-serif",
              "description": "Font family for all headings. CSS font-family stack — include fallbacks."
            },
            "font_size_base": {
              "type": "number",
              "minimum": 14,
              "maximum": 20,
              "default": 16,
              "description": "Body base font size in px. Hard-bounded 14–20 so small models cannot emit extreme sizes."
            },
            "type_scale_ratio": {
              "type": "number",
              "minimum": 1.125,
              "maximum": 1.5,
              "default": 1.25,
              "description": "Modular scale ratio. Build generates --font-size--1..6 = base * ratio^n."
            },
            "body_line_height": {
              "type": "number",
              "minimum": 1.4,
              "maximum": 1.8,
              "default": 1.6,
              "description": "Line height multiplier for body text."
            },
            "heading_line_height": {
              "type": "number",
              "minimum": 1.0,
              "maximum": 1.3,
              "default": 1.15,
              "description": "Line height multiplier for headings."
            },
            "measure": {
              "type": "number",
              "minimum": 60,
              "maximum": 75,
              "default": 68,
              "description": "Optimal line length in ch for body copy."
            },
            "heading_weight": {
              "type": "integer",
              "minimum": 300,
              "maximum": 900,
              "default": 700,
              "description": "Overrides the heading_style enum weight when set."
            },
            "heading_letter_spacing": {
              "type": "string",
              "pattern": "^[-+]?[0-9.]+(em)?$",
              "default": "0",
              "description": "Overrides the heading_style enum letter-spacing. Valid range -0.04em..0.12em; bounds enforced by validate_design_tokens()."
            }
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sidebar_width": {
              "type": "string",
              "default": "280px",
              "description": "Width of the sidebar (e.g., '280px', '300px', '320px')."
            },
            "max_width": {
              "type": "string",
              "default": "1400px",
              "description": "Maximum content width for the main area (e.g., '1200px', '1400px', '1600px')."
            }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "space_base": {
              "type": "integer",
              "enum": [4, 8],
              "default": 8,
              "description": "Base spacing unit in px. Build emits --space-1..8 = base * n."
            },
            "space_ratio": {
              "type": "number",
              "minimum": 1.5,
              "maximum": 2,
              "default": 1.5,
              "description": "Geometric spacing ratio; alternative to fixed space_base."
            }
          }
        },
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "radius_base": {
              "type": "number",
              "minimum": 0,
              "maximum": 16,
              "default": 8,
              "description": "Base corner radius in px. Build emits --radius-sm/md/lg/xl."
            },
            "radius_card": {
              "type": "number",
              "minimum": 0,
              "maximum": 48,
              "description": "Optional per-element override for cards. Defaults to radius_base-derived steps."
            },
            "radius_button": {
              "type": "number",
              "minimum": 0,
              "maximum": 48,
              "description": "Optional per-element override for buttons. Defaults to radius_base-derived steps."
            },
            "radius_pill": {
              "type": "number",
              "minimum": 0,
              "maximum": 48,
              "description": "Optional per-element override for pill/tag shapes. Defaults to radius_base-derived steps."
            }
          }
        },
        "elevation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shadow_strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.35,
              "description": "0 = flat, 1 = maximum depth. Drives --shadow-1..4 alpha."
            },
            "shadow_softness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5,
              "description": "0 = tight/hard shadow, 1 = large/soft blur."
            }
          }
        },
        "border": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "border_width": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 1,
              "description": "Structural border width in px."
            },
            "border_style": {
              "type": "string",
              "enum": ["solid", "none"],
              "default": "solid",
              "description": "Border style for structural dividers."
            },
            "border_color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Optional explicit border color. Defaults to derived --color-border from the neutral ramp."
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transition_duration": {
              "type": "number",
              "minimum": 120,
              "maximum": 360,
              "default": 200,
              "description": "Base transition duration in ms."
            },
            "transition_easing": {
              "type": "string",
              "enum": ["ease", "ease-in-out", "ease-out", "linear", "material-standard", "snappy"],
              "default": "ease-out",
              "description": "Curated easing curves only — no raw cubic-bezier from the LLM."
            }
          }
        },
        "effects": {
          "type": "object",
          "description": "Visual personality of the site. All fields are optional; omitting any field applies its default.",
          "additionalProperties": false,
          "properties": {
            "card_style": {
              "type": "string",
              "enum": ["image-overlay", "flat", "outlined", "elevated"],
              "default": "image-overlay",
              "description": "Dominant visual treatment of link cards."
            },
            "hover_effect": {
              "type": "string",
              "enum": ["none", "lift", "glow", "outline"],
              "default": "lift",
              "description": "Animation feedback when hovering over link cards."
            },
            "heading_style": {
              "type": "string",
              "enum": ["natural", "editorial", "elegant", "uppercase"],
              "default": "natural",
              "description": "Typographic personality of all headings and prominent labels."
            },
            "entry_animation": {
              "type": "string",
              "enum": ["none", "fade", "slide-up", "fade-slide-up"],
              "default": "fade-slide-up",
              "description": "Entry animation for link cards when they first appear (scroll into viewport or reappear after filtering). 'none' disables entry animation entirely."
            }
          }
        }
      }
    }
  }
}
